{
  "name": "cloudflare-starter",
  "version": "0.0.1",
  "description": "A SvelteKit + Cloudflare Workers + D1 starter with a guestbook.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "svelte-kit sync && husky",
    "dev": "vite dev",
    "internal:build": "vite build",
    "build": "make build",
    "preview": "npm run build && wrangler dev",
    "internal:check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "make check",
    "internal:lint": "prettier --check . && eslint --max-warnings 0 . && markdownlint-cli2",
    "lint": "make lint",
    "internal:format": "prettier --write . && eslint --fix .",
    "format": "make exec COMMAND='npm run internal:format'",
    "internal:test": "vitest run",
    "test": "make test",
    "migrate": "wrangler d1 migrations apply guestbook-db --local",
    "deploy": "npm run build && wrangler deploy",
    "clean": "rm -rf .svelte-kit build .wrangler"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^10.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "markdownlint-cli2@0.24.0": {
      "markdownlint": "0.42.1",
      "katex": "0.19.1"
    }
  }
}
