#!/bin/sh
set -eu
action=${1:?Expected check, lint, test or build}
case "$action" in check|lint|test|build) ;; *) exit 2 ;; esac
node --version >&2
npm --version >&2
mkdir -p /scratch/node
cp package.json package-lock.json /scratch/node/
npm ci --prefix /scratch/node --maxsockets=1 --ignore-scripts --no-audit --no-fund >&2
cp -R /scratch/node/node_modules node_modules
run_task() (
    task=$1
npx --no-install svelte-kit sync
export PATH="/work/node_modules/.bin:${PATH}"
export HUSKY=0
case "$task" in
lint)
    npm run check
    npx --no-install prettier --check .
    exec npx --no-install eslint --max-warnings 0 .
    ;;
test)
    exec npm run test
    ;;
build)
    exec npm run build
    ;;
esac
)
if [ "$action" = check ]; then
    for task in lint test build; do run_task "$task"; done
else
    run_task "$action"
fi
if [ "$action" = build ] && [ -d /outputs ]; then
    mkdir -p /outputs/.svelte-kit
    cp -R .svelte-kit/cloudflare /outputs/.svelte-kit/
    find /outputs -mindepth 1 -type d -exec chmod a+rwx {} +
fi
