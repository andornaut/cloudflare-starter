{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-starter",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "guestbook-db",
			// Replace with the id printed by `npx wrangler d1 create guestbook-db`.
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"observability": {
		"enabled": true
	}
	// ADMIN_SECRET is a Worker secret (`npx wrangler secret put ADMIN_SECRET`),
	// never a `vars` entry: this file is committed.
	//
	// To serve a custom domain, add:
	// "routes": [{ "pattern": "guestbook.example.com", "custom_domain": true }]
}
