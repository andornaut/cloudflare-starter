{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-starter",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			// The app reads platform.env.DB, so the binding name is part of the
			// code. A fork replaces database_id with the one its own
			// `npx wrangler d1 create guestbook-db` prints.
			"binding": "DB",
			"database_name": "guestbook-db",
			"database_id": "276030c4-650d-4779-a99b-e55e3167877d"
		}
	],
	"observability": {
		"enabled": true
	}
	// ADMIN_SECRET is a Worker secret (`npx wrangler secret put ADMIN_SECRET`),
	// never a `vars` entry: this file is committed.
	//
	// To serve a custom domain, add:
	// "routes": [{ "pattern": "guestbook.example.com", "custom_domain": true }]
}
